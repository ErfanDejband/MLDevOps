# Copy this to CICD_MLops/team1_dnn/.env and fill in your values
# NEVER commit the actual .env file (it's in .gitignore)
#
# TWO-SERVER architecture (real-world pattern):
#   DEV  server → developer experiments + registers 'staging' model here
#   PROD server → CI pipeline writes 'champion' model here (read-only for developers)
#
# ── DEV server (used locally by developer) ───────────────────────────────────
MLFLOW_DEV_TRACKING_URI=https://dagshub.com/USERNAME/mlops-dev-tracking.mlflow
MLFLOW_DEV_USERNAME=USERNAME
MLFLOW_DEV_PASSWORD=<your_dagshub_token>
#
# ── GitHub Actions Secrets (CI uses both servers) ────────────────────────────
# Go to: GitHub repo → Settings → Secrets and variables → Actions → New secret
#
# Secret name                │ Value
# ───────────────────────────┼──────────────────────────────────────────────────
# MLFLOW_DEV_TRACKING_URI    │ https://dagshub.com/USERNAME/mlops-dev-tracking.mlflow
# MLFLOW_DEV_USERNAME        │ USERNAME
# MLFLOW_DEV_PASSWORD        │ <dagshub token>
# MLFLOW_PROD_TRACKING_URI   │ https://dagshub.com/USERNAME/mlops-prod-tracking.mlflow
# MLFLOW_PROD_USERNAME       │ USERNAME
# MLFLOW_PROD_PASSWORD       │ <dagshub token>
# SECRET_TEST_DATA_B64       │ contents of Documents/secret_test_100_b64.txt
